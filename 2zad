-- 1. По количеству клиентов


CREATE PROCEDURE GetMostPopularBarber
AS
BEGIN

    SELECT TOP 1
        b.BarberID,
        b.FullName,
        b.Position,
        COUNT(DISTINCT v.ClientID) AS ClientCount
    FROM Barbers b
    JOIN VisitArchive v
        ON b.BarberID = v.BarberID
    GROUP BY
        b.BarberID,
        b.FullName,
        b.Position
    ORDER BY COUNT(DISTINCT v.ClientID) DESC;

END;
GO


 --  2. ТОП-3 БАРБЕРА ЗА МЕСЯЦ



CREATE PROCEDURE GetTop3BarbersByMonth
    @Year INT,
    @Month INT
AS
BEGIN

    SELECT TOP 3
        b.BarberID,
        b.FullName,
        b.Position,
        SUM(v.TotalPrice) AS TotalMoney
    FROM Barbers b
    JOIN VisitArchive v
        ON b.BarberID = v.BarberID
    WHERE YEAR(v.VisitDate) = @Year
      AND MONTH(v.VisitDate) = @Month
    GROUP BY
        b.BarberID,
        b.FullName,
        b.Position
    ORDER BY SUM(v.TotalPrice) DESC;

END;
GO



--   3. ТОП-3 БАРБЕРА ЗА ВСЁ ВРЕМЯ



CREATE PROCEDURE GetTop3BarbersByRating
AS
BEGIN

    SELECT TOP 3
        b.BarberID,
        b.FullName,
        b.Position,

        COUNT(v.VisitID) AS VisitCount,

        AVG(
            CASE v.Rating
                WHEN N'очень плохо' THEN 1
                WHEN N'плохо' THEN 2
                WHEN N'нормально' THEN 3
                WHEN N'хорошо' THEN 4
                WHEN N'великолепно' THEN 5
            END
        ) AS AverageRating

    FROM Barbers b

    JOIN VisitArchive v
        ON b.BarberID = v.BarberID

    GROUP BY
        b.BarberID,
        b.FullName,
        b.Position

    HAVING COUNT(v.VisitID) >= 30

    ORDER BY AverageRating DESC;

END;
GO


 --  4. РАСПИСАНИЕ БАРБЕРА НА КОНКРЕТНЫЙ ДЕНЬ


CREATE PROCEDURE GetBarberSchedule
    @BarberID INT,
    @WorkDate DATE
AS
BEGIN

    SELECT
        b.BarberID,
        b.FullName,
        b.Position,
        s.WorkDate,
        s.StartTime,
        s.EndTime,
        s.IsAvailable
    FROM Barbers b

    JOIN Schedule s
        ON b.BarberID = s.BarberID

    WHERE b.BarberID = @BarberID
      AND s.WorkDate = @WorkDate;

END;
GO



 --  5. СВОБОДНЫЕ ВРЕМЕННЫЕ ПРОМЕЖУТКИ НА НЕДЕЛЮ КОНКРЕТНОГО БАРБЕРА


CREATE PROCEDURE GetFreeTimeSlots
    @BarberID INT,
    @WeekStart DATE
AS
BEGIN

    SELECT
        s.WorkDate,
        s.StartTime AS FreeFrom,
        s.EndTime AS FreeTo
    FROM Schedule s
    WHERE s.BarberID = @BarberID
      AND s.WorkDate BETWEEN @WeekStart
                         AND DATEADD(DAY, 6, @WeekStart)
      AND s.IsAvailable = 1
      AND NOT EXISTS
      (
          SELECT 1
          FROM Appointments a
          WHERE a.BarberID = s.BarberID
            AND a.AppointmentDate = s.WorkDate
            AND a.AppointmentTime >= s.StartTime
            AND a.AppointmentTime < s.EndTime
      );

END;
GO


  -- 6. ПЕРЕНЕСТИ ЗАВЕРШЕННЫЕ УСЛУГИ В АРХИВ

CREATE PROCEDURE ArchiveCompletedVisits
AS
BEGIN

    INSERT INTO VisitArchive
    (
        ClientID,
        BarberID,
        ServiceID,
        VisitDate,
        TotalPrice,
        Rating,
        FeedbackText
    )
    SELECT
        a.ClientID,
        a.BarberID,
        a.ServiceID,
        a.AppointmentDate,
        s.Price,
        N'нормально',
        N'Перенесено в архив'
    FROM Appointments a

    JOIN Services s
        ON a.ServiceID = s.ServiceID

    WHERE a.AppointmentDate < CAST(GETDATE() AS DATE);


    DELETE FROM Appointments
    WHERE AppointmentDate < CAST(GETDATE() AS DATE);

END;
GO



 --  7. ТРИГГЕР НЕЛЬЗЯ ЗАПИСАТЬ КЛИЕНТА НА ЗАНЯТОЕ ВРЕМЯ

CREATE TRIGGER PreventBusyAppointment
ON Appointments
AFTER INSERT
AS
BEGIN

    IF EXISTS
    (
        SELECT 1
        FROM inserted i
        JOIN Appointments a
            ON a.BarberID = i.BarberID
            AND a.AppointmentDate = i.AppointmentDate
            AND a.AppointmentTime = i.AppointmentTime
            AND a.AppointmentID <> i.AppointmentID
    )
    BEGIN

        ROLLBACK TRANSACTION;

        RAISERROR
        (
            N'Это время уже занято.',
            16,
            1
        );

    END;

END;
GO



 --  8. ТРИГГЕР НЕЛЬЗЯ ДОБАВИТЬ НОВОГО ДЖУНИОР-БАРБЕРА,  ЕСЛИ УЖЕ РАБОТАЮТ 5 ДЖУНИОР-БАРБЕРОВ

CREATE TRIGGER PreventSixthJuniorBarber
ON Barbers
AFTER INSERT
AS
BEGIN

    IF
    (
        SELECT COUNT(*)
        FROM Barbers
        WHERE Position = N'джуниор-барбер'
    ) > 5

    BEGIN

        ROLLBACK TRANSACTION;

        RAISERROR
        (
            N'Нельзя добавить больше 5 джуниор-барберов.',
            16,
            1
        );

    END;

END;
GO


--   9. КЛИЕНТЫ БЕЗ ОТЗЫВА И ОЦЕНКИ

CREATE PROCEDURE GetClientsWithoutFeedback
AS
BEGIN

    SELECT
        c.ClientID,
        c.FullName,
        c.Phone,
        c.Email
    FROM Clients c

    WHERE NOT EXISTS
    (
        SELECT 1
        FROM Feedback f
        WHERE f.ClientID = c.ClientID
    );

END;
GO



  -- 10. КЛИЕНТЫ, КОТОРЫЕ НЕ ПОСЕЩАЛИ БАРБЕРШОП БОЛЕЕ ОДНОГО ГОДА

CREATE PROCEDURE GetInactiveClients
AS
BEGIN

    SELECT
        c.ClientID,
        c.FullName,
        c.Phone,
        c.Email,
        MAX(v.VisitDate) AS LastVisit
    FROM Clients c

    JOIN VisitArchive v
        ON c.ClientID = v.ClientID

    GROUP BY
        c.ClientID,
        c.FullName,
        c.Phone,
        c.Email

    HAVING MAX(v.VisitDate) <
           DATEADD(YEAR, -1, CAST(GETDATE() AS DATE));

END;
GO



