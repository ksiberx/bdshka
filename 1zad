 --  Количество полных лет работы барбера


CREATE FUNCTION GetWorkYears
(
    @HireDate DATE
)
RETURNS INT
AS
BEGIN
    RETURN DATEDIFF(YEAR, @HireDate, GETDATE())
           - CASE
               WHEN DATEADD
               (
                   YEAR,
                   DATEDIFF(YEAR, @HireDate, GETDATE()),
                   @HireDate
               ) > GETDATE()
               THEN 1
               ELSE 0
             END;
END;
GO


 --  1. БАРБЕР, КОТОРЫЙ РАБОТАЕТ ДОЛЬШЕ ВСЕХ


CREATE PROCEDURE GetMostExperiencedBarber
AS
BEGIN

    SELECT TOP 1
        BarberID,
        FullName,
        Gender,
        Phone,
        Email,
        BirthDate,
        HireDate,
        Position,
        dbo.GetWorkYears(HireDate) AS WorkYears
    FROM Barbers
    ORDER BY HireDate ASC;

END;
GO


 --  2. БАРБЕР, КОТОРЫЙ ОБСЛУЖИЛ МАКСИМАЛЬНОЕ КОЛИЧЕСТВО КЛИЕНТОВ В УКАЗАННОМ ДИАПАЗОНЕ ДАТ


CREATE PROCEDURE GetTopBarberByDateRange
    @DateFrom DATE,
    @DateTo DATE
AS
BEGIN

    SELECT TOP 1
        b.BarberID,
        b.FullName,
        b.Gender,
        b.Phone,
        b.Email,
        b.BirthDate,
        b.HireDate,
        b.Position,
        COUNT(DISTINCT v.ClientID) AS ClientCount
    FROM Barbers b
    JOIN VisitArchive v
        ON b.BarberID = v.BarberID
    WHERE v.VisitDate BETWEEN @DateFrom AND @DateTo
    GROUP BY
        b.BarberID,
        b.FullName,
        b.Gender,
        b.Phone,
        b.Email,
        b.BirthDate,
        b.HireDate,
        b.Position
    ORDER BY COUNT(DISTINCT v.ClientID) DESC;

END;
GO



  -- 3. КЛИЕНТ, КОТОРЫЙ ПОСЕТИЛ БАРБЕРШОП МАКСИМАЛЬНОЕ КОЛИЧЕСТВО РАЗ

CREATE PROCEDURE GetMostFrequentClient
AS
BEGIN

    SELECT TOP 1
        c.ClientID,
        c.FullName,
        c.Phone,
        c.Email,
        COUNT(v.VisitID) AS VisitCount
    FROM Clients c
    JOIN VisitArchive v
        ON c.ClientID = v.ClientID
    GROUP BY
        c.ClientID,
        c.FullName,
        c.Phone,
        c.Email
    ORDER BY COUNT(v.VisitID) DESC;

END;
GO


--   4. КЛИЕНТ, КОТОРЫЙ ПОТРАТИЛ МАКСИМАЛЬНОЕ КОЛИЧЕСТВО ДЕНЕГ


CREATE PROCEDURE GetBiggestSpender
AS
BEGIN

    SELECT TOP 1
        c.ClientID,
        c.FullName,
        c.Phone,
        c.Email,
        SUM(v.TotalPrice) AS TotalSpent
    FROM Clients c
    JOIN VisitArchive v
        ON c.ClientID = v.ClientID
    GROUP BY
        c.ClientID,
        c.FullName,
        c.Phone,
        c.Email
    ORDER BY SUM(v.TotalPrice) DESC;

END;
GO


 --  5. САМАЯ ДЛИННАЯ ПО ВРЕМЕНИ УСЛУГА

CREATE PROCEDURE GetLongestService
AS
BEGIN

    SELECT TOP 1
        ServiceID,
        ServiceName,
        Price,
        DurationMinutes
    FROM Services
    ORDER BY DurationMinutes DESC;

END;
GO



