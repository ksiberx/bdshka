-- 23 [хранимая процедура] Клиенты без фидбека и оценок
CREATE PROCEDURE sp_GetClientsWithoutFeedbackAndRating
AS
BEGIN
    SELECT DISTINCT 
        c.ClientID,
        c.FullName,
        c.Phone,
        c.Email
    FROM Clients c
    INNER JOIN ClientVisitsArchive v ON c.ClientID = v.ClientID
    WHERE c.ClientID NOT IN (
        SELECT ClientID 
        FROM ClientVisitsArchive 
        WHERE Feedback IS NOT NULL OR Rating IS NOT NULL
    );
END;
GO

-- Вызов
EXEC sp_GetClientsWithoutFeedbackAndRating;
GO


-- 24 [хранимая процедура Клиенты, не посещавшие салон свыше одного года
CREATE PROCEDURE sp_GetClientsInactiveOverOneYear
AS
BEGIN
    SELECT 
        c.ClientID,
        c.FullName,
        c.Phone,
        c.Email,
        MAX(v.VisitDate) AS LastVisitDate
    FROM Clients c
    LEFT JOIN ClientVisitsArchive v ON c.ClientID = v.ClientID
    GROUP BY c.ClientID, c.FullName, c.Phone, c.Email
    HAVING MAX(v.VisitDate) < DATEADD(YEAR, -1, GETDATE()) 
        OR MAX(v.VisitDate) IS NULL;
END;
GO

-- Вызов
EXEC sp_GetClientsInactiveOverOneYear;
GO
